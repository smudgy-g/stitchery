{
  "base": "main",
  "tracker": {
    "command": ["github"]
  },
  "paths": {
    "tests": ["test/**", "tests/**", "**/*.test.*", "**/*.spec.*"],
    "protected": [".factory/**"],
    "sensitive": []
  },
  "sandbox": {
    "kit": "shell",
    "cpus": 2,
    "memory": "6g",
    "allowlist": [
      "nodejs.org",
      "registry.npmjs.org",
      "astral.sh",
      "releases.astral.sh",
      "github.com",
      "release-assets.githubusercontent.com",
      "pypi.org",
      "files.pythonhosted.org"
    ],
    "maxConcurrent": 1
  },
  "acceptance": { "assets": ".factory/assets" },
  "commands": {
    "changedCode": ["**/*"],
    "setup": [["bash", ".factory/sandbox-setup.sh"]],
    "autofix": [],
    "check": [],
    "gates": [
      ["pnpm", "--dir", "client", "build"],
      [
        "uv",
        "--directory",
        "server",
        "run",
        "python",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests"
      ]
    ],
    "preview": [
      "pnpm",
      "--dir",
      "client",
      "dev",
      "--host",
      "0.0.0.0",
      "--port",
      "5173",
      "--strictPort"
    ],
    "env": {
      "CI": "true",
      "PATH": "/home/agent/node/bin:/home/agent/.local/bin:/usr/local/bin:/usr/bin:/bin"
    }
  }
}
